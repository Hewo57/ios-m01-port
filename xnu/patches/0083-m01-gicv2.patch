diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..d9203c3 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,165 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif HAS_GIC_V2
+/*
+ * GICv2 (M01): a memory-mapped distributor and per-CPU interface.  The
+ * bootloader leaves TrustZone owning Group 0, so every interrupt XNU uses
+ * (architected virtual timer, SGIs, device SPIs) is Group 1 and is taken as
+ * an IRQ through sleh_irq().
+ */
+#if defined(SWEET)
+/* Phone default; the live FDT may override it. */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+#endif
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+
+/*
+ * GICv2 CPU interface number used as the SGIR target bit for each logical
+ * CPU.  A PPI's banked ITARGETSR view reports the local interface's bit, so
+ * this is the only portable way to map logical CPUs to SGIR targets.
+ */
+static uint8_t sweet_gic_cpu_map[MAX_CPUS];
+
+static uint32_t
+_gic_read32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
+
+static void
+_gic_write32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+#define gicd_read32(offset) (_gic_read32(gicd_base + (offset)))
+#define gicd_write32(offset, data) (_gic_write32(gicd_base + (offset), (data)))
+#define gicc_read32(offset) (_gic_read32(gicc_base + (offset)))
+#define gicc_write32(offset, data) (_gic_write32(gicc_base + (offset), (data)))
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	// gicd_base is 0x0 only before it's initialized by the boot processor.
+	// Avoid calling SecureDT* routines on secondary processors to avoid
+	// race conditions because they are not thread-safe.
+	if (!gicd_base) {
+		// Find GIC DT node
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		// Find "reg" property
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+
+		// Need at least GICD base, GICD size, GICC base and GICC size
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+#if defined(SWEET)
+		/* Read only on the boot CPU, before the GIC and RO-late lockdown. */
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+		kprintf("SWEET GIC: virtual timer INTID %u (GICv2)\n", sweet_vtimer_intid);
+#endif
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+
+		uint64_t const gicd_base_prop = ((uint64_t const *) prop)[0];
+		uint64_t const gicd_size_prop = ((uint64_t const *) prop)[1];
+		uint64_t const gicc_base_prop = ((uint64_t const *) prop)[2];
+		uint64_t const gicc_size_prop = ((uint64_t const *) prop)[3];
+
+		gicd_base = ml_io_map(soc_base_phys + gicd_base_prop, gicd_size_prop);
+		if (!gicd_base) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+
+		gicc_base = ml_io_map(soc_base_phys + gicc_base_prop, gicc_size_prop);
+		if (!gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+	}
+
+	/* Per-CPU interface: no priority splitting, accept every priority. */
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	gicc_write32(GICC_CTLR, GICC_CTLR_ENABLEGRP1);
+
+	/*
+	 * Record this CPU's SGIR target bit before enabling interrupts.
+	 * ITARGETSR for INTIDs 0-31 is banked per CPU interface and read-only;
+	 * its low byte is the local interface's bit in the SGIR target list.
+	 */
+	unsigned int cpu = ml_get_cpu_number_local();
+	uint32_t target = gicd_read32(GICD_ITARGETSR + (16 / 4) * 4) & 0xFF;
+	__atomic_store_n(&sweet_gic_cpu_map[cpu], (uint8_t)target, __ATOMIC_RELEASE);
+
+	/* Group 1 owns everything XNU uses. */
+	gicd_write32(GICD_IGROUPR, gicd_read32(GICD_IGROUPR) |
+	    (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	/* Private interrupts: one priority byte per INTID, 0xA0 for all. */
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	/* Enable forwarding of Group 1 to this CPU interface. */
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+	__builtin_arm_isb(ISB_SY);
+}
+
+uint32_t
+pe_arm_gic_ack(void)
+{
+	return gicc_read32(GICC_IAR);
+}
+
+void
+pe_arm_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+}
+
+void
+pe_arm_gic_send_sgi(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		panic("%s: invalid logical CPU %u", __func__, cpu);
+	}
+	uint32_t target = __atomic_load_n(&sweet_gic_cpu_map[cpu], __ATOMIC_ACQUIRE);
+	if (target == 0) {
+		panic("%s: CPU %u has no GICv2 interface mapping", __func__, cpu);
+	}
+	__builtin_arm_dsb(DSB_SY);
+	gicd_write32(GICD_SGIR, GICD_SGIR_NSATTBR | GICD_SGIR_TARGET_LIST |
+	    ((target & 0xFF) << 16) | SWEET_IPI_SGI);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
