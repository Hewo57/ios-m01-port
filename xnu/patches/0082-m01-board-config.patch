diff --git a/pexpert/pexpert/arm64/M01.h b/pexpert/pexpert/arm64/M01.h
new file mode 100644
index 0000000..7409bba
--- /dev/null
+++ b/pexpert/pexpert/arm64/M01.h
@@ -0,0 +1,81 @@
+/*
+ * Board config for the Samsung Galaxy M01 (SM-M015G/DS, Qualcomm SDM439 /
+ * Snapdragon 439): eight Cortex-A53 cores in two clusters of four.
+ *
+ * The A53 is ARMv8.0-A: no LSE atomics, no PAN, no 16K page granule.  The
+ * interrupt controller is a GICv2 (distributor + per-CPU interface) rather
+ * than the GICv3 used by sweet, and the bootloader is Samsung's Odin-only
+ * ABL, so there is no fastboot and no recovery ramdisk handoff.
+ *
+ * This file is included instead of SWEET.h, but it defines SWEET so that the
+ * shared device-tree platform, timer and CPU drivers compile unchanged.
+ */
+
+#ifndef _PEXPERT_ARM64_M01_H
+#define _PEXPERT_ARM64_M01_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define M01                       1
+#define SWEET                     1
+
+/* All eight A53s as one homogeneous SMP cluster (PSCI CPU_ON). */
+#define SWEET_SMP_MAX_CPUS         8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+/* no __ARM_PAN_AVAILABLE__: PAN is ARMv8.1, the A53 is ARMv8.0 */
+/* no __ARM_16K_PG__: the A53 supports only the 4K translation granule */
+
+#define HAS_GIC_V2                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * msm8937 remaps the architected timer PPIs: the DT lists
+ * <1 2> secure phys, <1 3> non-secure phys, <1 4> virtual, <1 1> hyp.
+ * XNU drives the virtual timer (CNTV), so its PPI is 4 => INTID 16 + 4 = 20.
+ */
+#define SWEET_VTIMER_INTID        20
+#define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+/* GICv2 register definitions (Arm IHI 0048B) */
+#define GICD_CTLR                 0x000
+#define GICC_CTLR                 0x000
+#define GICC_PMR                  0x004
+#define GICC_BPR                  0x008
+#define GICC_IAR                  0x00C
+#define GICC_EOIR                 0x010
+#define GICC_HPPIR                0x018
+#define GICC_DIR                  0x1000
+
+#define GICD_ISENABLER            0x100
+#define GICD_ICENABLER            0x180
+#define GICD_ISPENDR              0x200
+#define GICD_ICPENDR              0x280
+#define GICD_ISACTIVER            0x300
+#define GICD_ICACTIVER            0x380
+#define GICD_IPRIORITYR           0x400
+#define GICD_ITARGETSR            0x800
+#define GICD_ICFGR                0xC00
+#define GICD_SGIR                 0xF00
+
+/* Non-secure view of GICD_CTLR / GICC_CTLR when DS=0. */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICC_CTLR_ENABLEGRP1      0x1
+
+#define GICD_SGIR_NSATTBR         (1U << 15)
+#define GICD_SGIR_TARGET_LIST     (0U << 24)
+#define GICD_SGIR_TARGET_SELF     (2U << 24)
+
+#endif /* ! _PEXPERT_ARM64_M01_H */
